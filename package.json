{
  "name": "pokeapp",
  "version": "1.0.0",
  "description": "A React application for displaying Pokémon data.",
  "author": "Paul Dias",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "rspack --mode=development serve",
    "build": "rspack --mode=production build",
    "start": "rspack --mode=production serve",
    "dev:proxy": "POKEAPI_PROXY=1 rspack --mode=development serve",
    "api": "npm --prefix api start",
    "biome:lint": "biome lint --verbose .",
    "biome:lint:fix": "biome lint --write --verbose .",
    "biome:format": "biome format --write --verbose .",
    "biome:check": "biome ci .",
    "biome:check:fix": "biome check --fix .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "npm run biome:check && npm run type-check && npm run build && npm run test:coverage",
    "verify:full": "npm run verify && npm run e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.74.4",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "@uidotdev/usehooks": "^2.4.1",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-aria-components": "^1.8.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-router": "^7.5.3",
    "react-virtualized": "^9.22.6",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-react": "^7.26.3",
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.63.0",
    "@rspack/cli": "^1.3.4",
    "@rspack/core": "^1.3.4",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-virtualized": "^9.22.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "html-webpack-plugin": "^5.6.3",
    "lefthook": "^2.1.14",
    "playwright": "^1.63.0",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.3",
    "tailwindcss-react-aria-components": "^2.0.0",
    "ts-checker-rspack-plugin": "^1.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.3.0"
  }
}
