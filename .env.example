# Reference for the environment variables the project reads. None are required.
# Nothing loads a .env file automatically (no dotenv): set them in your shell,
# e.g. `POKEAPI_CACHE_MAX_AGE_DAYS=7 npm run api`, or load this file yourself
# with `node --env-file=.env ...`.

# Build-time switch for the frontend: route PokeAPI requests through the local
# caching proxy (`npm run api`, port 3001). `npm run dev:proxy` sets this for you.
# POKEAPI_PROXY=1

# Proxy server (api/): where cached GraphQL responses and assets are written.
# Default: api/.cache
# POKEAPI_CACHE_DIR=api/.cache

# Proxy server (api/): evict cache files unused for this many days at startup.
# Must be a positive number; anything else is ignored. Default: 30.
# POKEAPI_CACHE_MAX_AGE_DAYS=30
